# ====== إعدادات قاعدة البيانات ======
DATABASE_URL=file:/home/z/my-project/db/custom.db

# ====== سر الجلسة (لتوقيع JWT) ======
# يجب تغييره في الإنتاج إلى قيمة عشوائية طويلة (32+ حرف)
JWT_SECRET=change-this-to-a-long-random-secret-in-production-32chars

# ====== عنوان التطبيق (لروابط إعادة تعيين كلمة المرور) ======
# في الإنتاج، ضع عنوان URL العام للتطبيق
NEXTAUTH_URL=http://localhost:3000

# ====== بريد المدير (له صلاحية الوصول إلى لوحة التحكم) ======
# المستخدم المسجل بهذا البريد يحصل على صلاحية المدير تلقائياً
ADMIN_EMAIL=admin@your-domain.com

# ====== إعدادات الإرسال عبر Resend API (الموصى به) ======
# يمكن تغييرها من لوحة التحكم دون تعديل هذا الملف
# 1. سجّل في https://resend.com (مجاني، بدون بطاقة ائتمان)
# 2. أنشئ API Key من لوحة التحكم
# 3. استخدم البريد الافتراضي: onboarding@resend.dev (للإرسال إلى بريدك المسجل)
# 4. للإرسال من نطاقك: أضف نطاقك في Resend ثم استخدم بريدك
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM="بوابة المنسقين <onboarding@resend.dev>"

# ====== إعدادات SMTP الاحتياطية (غير مفعّلة — تُستخدم فقط إذا لم تكن Resend) ======
# Gmail: smtp.gmail.com / 587 (يستخدم App Password)
# Outlook: smtp-mail.outlook.com / 587
# Mailgun: smtp.mailgun.org / 587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ====== الإعدادات العامة ======
PORTAL_NAME=بوابة المنسقين في دائرة المعلوماتية
MAX_FILE_SIZE_MB=25
